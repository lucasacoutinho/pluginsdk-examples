{
  "id": "acme-data",
  "version": "2.3.0",
  "description": "Answer business questions from the internal data warehouse with governed, read-only queries.",
  "skills": [
    "skills/query-warehouse"
  ],
  "mcp": {
    "warehouse": {
      "url": "https://warehouse.acme.internal/mcp",
      "headers": {}
    },
    "data-catalog": {
      "url": "https://data-catalog.acme.internal/mcp",
      "headers": {}
    }
  },
  "agents": {
    "data-analyst": {
      "description": "Answer a business question from governed warehouse tables and return the queries and caveats.",
      "prompt": "agents/data-analyst.md",
      "shell": "deny"
    }
  },
  "publish": {
    "type": "git",
    "repository": "git@github.com:acme/agent-plugins.git",
    "branch": "main",
    "marketplace": "acme"
  }
}
